{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "architecture": {
            "type": "string",
            "enum": [
                "",
                "amd64",
                "arm64"
            ]
        },
        "cookieDomain": {
            "type": "string"
        },
        "githubUsers": {
            "type": "string"
        },
        "global": {
            "type": "object",
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "properties": {
                        "enforced": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "hostName": {
            "type": "string"
        },
        "nginx": {
            "type": "object",
            "properties": {
                "ingress": {
                    "type": "object",
                    "properties": {
                        "annotations": {
                            "type": "object",
                            "properties": {
                                "cert-manager.io/cluster-issuer": {
                                    "type": "string"
                                },
                                "kubernetes.io/tls-acme": {
                                    "type": "string"
                                },
                                "nginx.ingress.kubernetes.io/auth-signin": {
                                    "type": "string"
                                },
                                "nginx.ingress.kubernetes.io/auth-url": {
                                    "type": "string"
                                },
                                "nginx.ingress.kubernetes.io/force-ssl-redirect": {
                                    "type": "string"
                                }
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "nodeSelector": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "oauth2proxy": {
            "type": "object",
            "properties": {
                "ingress": {
                    "type": "object",
                    "properties": {
                        "annotations": {
                            "type": "object"
                        }
                    }
                }
            }
        },
        "registry": {
            "type": "object",
            "properties": {
                "domain": {
                    "type": "string"
                }
            }
        },
        "resources": {
            "type": "object",
            "properties": {
                "intranet": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                },
                                "ephemeralStorage": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                },
                                "ephemeralStorage": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "oauth2proxy": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "route": {
            "type": "object",
            "properties": {
                "additionalRules": {
                    "type": "array"
                },
                "annotations": {
                    "type": "object"
                },
                "enabled": {
                    "type": "boolean"
                },
                "filters": {
                    "type": "array"
                },
                "labels": {
                    "type": "object"
                },
                "parentRefs": {
                    "type": "array"
                },
                "securityPolicy": {
                    "type": "object",
                    "properties": {
                        "annotations": {
                            "type": "object"
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "labels": {
                            "type": "object"
                        }
                    }
                }
            }
        },
        "secrets": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "key": {
                                    "type": "string"
                                },
                                "value": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "name": {
                        "type": "string"
                    }
                }
            }
        },
        "tolerations": {
            "type": "array",
            "items": {
                "type": "object"
            }
        }
    }
}
